# Public-safe placeholder only. Do not commit real API keys or mailbox credentials.
VITE_OUTREACH_BACKEND_URL=http://127.0.0.1:43127
OUTREACH_CONFIG=data/local-config.json
OUTREACH_DATABASE=data/outreach.sqlite
OUTREACH_PORT=43127
OUTREACH_ALLOWED_ORIGINS=http://127.0.0.1:5177,http://localhost:5177
OUTREACH_MAX_BODY_BYTES=2097152
# OUTREACH_LIVE_SEND=1

# Portable provider helpers. Python, Node.js, and executable helpers are accepted.
# OUTREACH_ENRICHMENT_HELPER=C:\path\to\contact-helper.py
# OUTREACH_ENRICHMENT_SETUP_HELPER=C:\path\to\contact-health.py
# OUTREACH_MAILBOX_HELPER=C:\path\to\mailbox-helper.js
# Optional for custom or local-model writing. The bundled plan bridges and named
# compatible API connections below do not use this helper.
# OUTREACH_WRITING_HELPER=C:\path\to\writing-helper.py

# Optional AI connection examples. Set one real value only in the private
# terminal/session that starts the backend. Never commit the value.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
